<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>TSC DA200 Open Driver</title>
  <options customize="never" require-scripts="false"
           hostArchitectures="arm64,x86_64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false"
           enable_localSystem="true"/>
  <allowed-os-versions>
    <os-version min="11.0"/>
  </allowed-os-versions>
  <choices-outline>
    <line choice="default"/>
  </choices-outline>
  <choice id="default" visible="false" title="TSC DA200 Open Driver">
    <pkg-ref id="org.openlabeldrivers.tsc-da200"/>
  </choice>
  <pkg-ref id="org.openlabeldrivers.tsc-da200" version="@VERSION@">clean-component.pkg</pkg-ref>
</installer-gui-script>
