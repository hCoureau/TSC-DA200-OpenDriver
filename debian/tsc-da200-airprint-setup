#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "Run this command with sudo." >&2
  exit 2
fi

if [ "$#" -ne 1 ]; then
  echo "Usage: tsc-da200-airprint-setup DEVICE-URI" >&2
  echo "Example: sudo tsc-da200-airprint-setup socket://192.0.2.20:9100" >&2
  exit 2
fi

case "$1" in
  usb://*|socket://*|serial://*) ;;
  *) echo "Unsupported device URI. Use usb://, socket://, or serial://." >&2; exit 2 ;;
esac

case "$1" in
  *'
'*|*''*) echo "Device URI must be a single line." >&2; exit 2 ;;
esac

install -d -o lp -g lp -m 0750 /var/spool/tsc-da200-printer-app
config_tmp=$(mktemp /etc/tsc-da200-printer-app.conf.XXXXXX)
trap 'rm -f "$config_tmp"' EXIT HUP INT TERM
printf '%s\n' \
  "device-uri=$1" \
  "printer-name=TSC DA200 4x6" \
  "server-port=8000" \
  "spool-directory=/var/spool/tsc-da200-printer-app" > "$config_tmp"
install -o root -g lp -m 0640 "$config_tmp" /etc/tsc-da200-printer-app.conf
systemctl daemon-reload
systemctl enable --now tsc-da200-printer-app.service
echo "AirPrint service started. The printer is advertised as TSC DA200 4x6."
